      "html": "<label class=\"ds-radio-row\"><input class=\"ds-radio-input\" type=\"radio\" name=\"ds-answer\" checked><span class=\"ds-radio-control\"></span><span>Sí</span></label>",
      "css": ".ds-radio-row{position:relative;display:flex;align-items:center;gap:12px;min-height:48px;padding:12px;border-radius:8px;color:var(--color-neutral-900,#171717);font-size:14px;line-height:1.5;cursor:pointer;font-family:'Montserrat Variable','Montserrat',sans-serif;}.ds-radio-row:hover{background:var(--color-neutral-50,#fafafa)}.ds-radio-row:has(input:checked){background:var(--color-indigo-50,#eef2ff)}.ds-radio-row:focus-within{outline:2px solid var(--color-indigo-700,#432dd7);outline-offset:-2px}.ds-radio-input{position:absolute;opacity:0;width:20px;height:20px}.ds-radio-control{display:flex;align-items:center;justify-content:center;flex:none;width:18px;height:18px;border:1px solid var(--color-neutral-300,#d4d4d4);border-radius:50%;background:white}.ds-radio-row:has(input:checked) .ds-radio-control{border-color:var(--color-indigo-700,#432dd7)}.ds-radio-row:has(input:checked) .ds-radio-control:after{content:\"\";width:10px;height:10px;border-radius:50%;background:var(--color-indigo-700,#432dd7)}@media(max-width:639px){.ds-radio-row{padding:12px 8px}}"
